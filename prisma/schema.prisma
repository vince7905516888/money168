generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  password           String
  role               Role                @default(MEMBER)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  twoFactorEnabled   Boolean             @default(false)
  twoFactorSecret    String?
  points             Int                 @default(0)
  transactions       Transaction[]
  categories         Category[]
  userBanks          UserBank[]
  userThirdParties   UserThirdParty[]
  userBrokers        UserBroker[]
  userFunds          UserFund[]
  userExchanges      UserExchange[]
  userDebtCategories UserDebtCategory[]
  userExchangeRates  UserExchangeRate[]
  investments        Investment[]
  debts              Debt[]
  userCurrencies     UserCurrency[]
  userFundNavs       UserFundNav[]
  userWatchStocks    UserWatchStock[]
  pagePermissions    PagePermission[]
}

model UserBank {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model UserThirdParty {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model UserBroker {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model UserFund {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model UserExchange {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model UserDebtCategory {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model UserExchangeRate {
  id        String   @id @default(cuid())
  currency  String
  rate      Float
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, currency])
}

model Debt {
  id        String   @id @default(cuid())
  category  String
  amount    Float
  bankName  String?
  date      DateTime @default(now())
  note      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 舊版功能殘留的資料表，目前程式碼未使用，保留以避免刪除既有資料
model UserCurrency {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model UserFundNav {
  id        String   @id @default(cuid())
  fundKey   String
  nav       Float
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, fundKey])
}

model UserWatchStock {
  id        String   @id @default(cuid())
  code      String
  name      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, code])
}

model Category {
  id           String          @id @default(cuid())
  name         String
  type         TransactionType
  icon         String?
  color        String?
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime        @default(now())
}

model Transaction {
  id         String          @id @default(cuid())
  title      String
  amount     Float
  type       TransactionType
  date       DateTime
  note       String?
  source     String          @default("CASH")
  currency   String?
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category?       @relation(fields: [categoryId], references: [id])
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Investment {
  id            String         @id @default(cuid())
  type          InvestmentType
  name          String?
  code          String?
  amount        Float
  quantity      Float?
  price         Float?
  broker        String?
  bankName      String?
  currency      String?
  exchangeRate  Float?
  action        TradeAction    @default(BUY)
  date          DateTime       @default(now())
  discount      Float?
  fee           Float?
  tax           Float?
  note          String?
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum InvestmentType {
  STOCK
  FUND
  FOREX
  CRYPTO
  GOLD
  REALESTATE
  INSURANCE
}

enum TradeAction {
  BUY
  SELL
}

enum Role {
  MEMBER
  ADMIN
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model FeeSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  rate        Float    @default(0)
  fixedAmount Float    @default(0)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PagePermission {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageKey String
  allowed Boolean

  @@unique([userId, pageKey])
}

model NavItemConfig {
  id      String  @id @default(cuid())
  key     String  @unique
  enabled Boolean @default(true)
  order   Int     @default(0)
}
