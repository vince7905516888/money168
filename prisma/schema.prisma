generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String             @id @default(cuid())
  name             String
  email            String             @unique
  password         String
  role             Role               @default(MEMBER)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  twoFactorEnabled Boolean            @default(false)
  twoFactorSecret  String?
  points           Int                @default(0)
  categories       Category[]
  Debt             Debt[]
  investments      Investment[]
  transactions     Transaction[]
  userBanks        UserBank[]
  userBrokers      UserBroker[]
  UserCurrency     UserCurrency[]
  UserDebtCategory UserDebtCategory[]
  UserExchange     UserExchange[]
  UserExchangeRate UserExchangeRate[]
  UserFund         UserFund[]
  UserFundNav      UserFundNav[]
  userThirdParties UserThirdParty[]
  UserWatchStock   UserWatchStock[]
  pagePermissions  PagePermission[]
}

model PagePermission {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageKey String
  allowed Boolean

  @@unique([userId, pageKey])
}

model NavItemConfig {
  id      String  @id @default(cuid())
  key     String  @unique
  enabled Boolean @default(true)
  order   Int     @default(0)
}

model UserBank {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model UserThirdParty {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model UserBroker {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Category {
  id           String          @id @default(cuid())
  name         String
  type         TransactionType
  icon         String?
  color        String?
  userId       String
  createdAt    DateTime        @default(now())
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id         String          @id @default(cuid())
  title      String
  amount     Float
  type       TransactionType
  date       DateTime
  note       String?
  userId     String
  categoryId String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  source     String          @default("CASH")
  currency   String?
  category   Category?       @relation(fields: [categoryId], references: [id])
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Investment {
  id            String         @id @default(cuid())
  type          InvestmentType
  name          String?
  code          String?
  amount        Float
  quantity      Float?
  note          String?
  userId        String
  transactionId String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  action        TradeAction    @default(BUY)
  date          DateTime       @default(now())
  discount      Float?
  fee           Float?
  price         Float?
  tax           Float?
  broker        String?
  bankName      String?
  currency      String?
  exchangeRate  Float?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FeeSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  rate        Float    @default(0)
  fixedAmount Float    @default(0)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Debt {
  id        String   @id
  category  String
  amount    Float
  bankName  String?
  date      DateTime @default(now())
  note      String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserCurrency {
  id        String   @id
  name      String
  userId    String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model UserDebtCategory {
  id        String   @id
  name      String
  userId    String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model UserExchange {
  id        String   @id
  name      String
  userId    String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model UserExchangeRate {
  id        String   @id
  currency  String
  rate      Float
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency])
}

model UserFund {
  id        String   @id
  name      String
  userId    String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model UserFundNav {
  id        String   @id
  fundKey   String
  nav       Float
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fundKey])
}

model UserWatchStock {
  id        String   @id
  code      String
  name      String?
  userId    String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
}

enum InvestmentType {
  STOCK
  FUND
  FOREX
  CRYPTO
  GOLD
  REALESTATE
  INSURANCE
}

enum TradeAction {
  BUY
  SELL
}

enum Role {
  MEMBER
  ADMIN
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}
