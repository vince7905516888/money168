generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  password           String
  role               Role                @default(MEMBER)
  tier               MemberTier          @default(FREE)
  isSuperAdmin       Boolean             @default(false)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  twoFactorEnabled   Boolean             @default(false)
  twoFactorSecret    String?
  points             Int                 @default(0)
  transactions       Transaction[]
  categories         Category[]
  userBanks          UserBank[]
  userThirdParties   UserThirdParty[]
  userBrokers        UserBroker[]
  userFunds          UserFund[]
  userExchanges      UserExchange[]
  userDebtCategories UserDebtCategory[]
  userExchangeRates  UserExchangeRate[]
  investments        Investment[]
  debts              Debt[]
  userCurrencies     UserCurrency[]
  userFundNavs       UserFundNav[]
  userWatchStocks    UserWatchStock[]
  strategyEntries    InvestmentStrategyEntry[]
  tokenUsageLogs     TokenUsageLog[]
  martingaleStrategies UserMartingaleStrategy[]
  activityLogs       MemberActivityLog[]
}

model UserBank {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model UserThirdParty {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model UserBroker {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model UserFund {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model UserExchange {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model UserDebtCategory {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model UserExchangeRate {
  id        String   @id @default(cuid())
  currency  String
  rate      Float
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, currency])
}

model Debt {
  id        String   @id @default(cuid())
  category  String
  amount    Float
  bankName  String?
  date      DateTime @default(now())
  note      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 舊版功能殘留的資料表，目前程式碼未使用，保留以避免刪除既有資料
model UserCurrency {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model UserFundNav {
  id        String   @id @default(cuid())
  fundKey   String
  nav       Float    @default(0)
  url       String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, fundKey])
}

model UserWatchStock {
  id        String   @id @default(cuid())
  code      String
  name      String?
  order     Int      @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, code])
}

model InvestmentStrategyEntry {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetType      String   @default("STOCK") // "STOCK"(台股) 或 "USSTOCK"(美股)，決定盈虧試算是否套用台股證交稅/手續費
  broker         String?
  stockName      String?
  stockCode      String?
  plan           String?
  shares         Float?
  avgPrice       Float?
  currentPrice   Float?
  dividendDate   String?
  dividendAmount Float?
  discount       Float    @default(1)
  futureLow      String?
  futureMid      String?
  futureHigh     String?
  batch1         Float?
  batch2         Float?
  batch3         Float?
  batch4         Float?
  batch5         Float?
  batch6         Float?
  // 記錄上次通知加碼信件時，該批的目標價是多少；跟目前 batchN 值相同代表已通知過，不用重複寄信，
  // 使用者改了目標價（值不同）就會被視為新目標，價格再次到價時會重新通知
  batch1NotifiedPrice Float?
  batch2NotifiedPrice Float?
  batch3NotifiedPrice Float?
  batch4NotifiedPrice Float?
  batch5NotifiedPrice Float?
  batch6NotifiedPrice Float?
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// 系統寄信設定（後台可改，不用重新部署）：改用 Resend 的 HTTPS API 寄信，不是 SMTP——
// Railway 對外網路把 SMTP 埠（25/465/587）整個擋掉了，Gmail SMTP 之類的方案在這個平台
// 上注定連不出去，只有走一般 HTTPS 的 API 才行得通。全站共用一組設定（用 findFirst
// 取得，只會有一筆），沒設定 API Key 時寄信功能視為未啟用。
model MailSetting {
  id           String   @id @default(cuid())
  resendApiKey String
  fromEmail    String   @default("MoneyFlow <onboarding@resend.dev>")
  updatedAt    DateTime @updatedAt
}

model Category {
  id           String          @id @default(cuid())
  name         String
  type         TransactionType
  icon         String?
  color        String?
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime        @default(now())
}

model Transaction {
  id         String          @id @default(cuid())
  title      String
  amount     Float
  type       TransactionType
  date       DateTime
  note       String?
  source     String          @default("CASH")
  currency   String?
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category?       @relation(fields: [categoryId], references: [id])
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Investment {
  id            String         @id @default(cuid())
  type          InvestmentType
  name          String?
  code          String?
  amount        Float
  quantity      Float?
  price         Float?
  broker        String?
  bankName      String?
  currency      String?
  exchangeRate  Float?
  action        TradeAction    @default(BUY)
  date          DateTime       @default(now())
  discount      Float?
  fee           Float?
  tax           Float?
  note          String?
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum InvestmentType {
  STOCK
  USSTOCK
  FUND
  FOREX
  CRYPTO
  GOLD
  REALESTATE
  INSURANCE
}

enum TradeAction {
  BUY
  SELL
}

enum Role {
  MEMBER
  ADMIN
}

enum MemberTier {
  FREE
  BASIC
  PRO
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model FeeSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  rate        Float    @default(0)
  fixedAmount Float    @default(0)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NavItemConfig {
  id      String  @id @default(cuid())
  key     String  @unique
  enabled Boolean @default(true)
  order   Int     @default(0)
}

model StockSignalRule {
  id        String   @id @default(cuid())
  code      String
  name      String?
  condition String   // "ABOVE" | "BELOW"
  value     Float
  note      String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MartingaleStrategy {
  id        String   @id @default(cuid())
  name      String
  ratios    Float[]
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 會員自訂的馬丁格爾策略，只有該會員自己看得到；新增/刪除時會寫一筆 MemberActivityLog
// 讓後台「會員變動紀錄」查得到
model UserMartingaleStrategy {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  ratios    Float[]
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  category  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

model AnalystVideoSummary {
  id        String   @id @default(cuid())
  url       String
  title     String?
  summary   String
  createdAt DateTime @default(now())
}

model Marquee {
  id        String   @id @default(cuid())
  text      String
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VideoHighlight {
  id        String   @id @default(cuid())
  date      DateTime
  title     String?
  content   String
  url       String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TierPageAccess {
  id      String     @id @default(cuid())
  tier    MemberTier
  pageKey String
  allowed Boolean

  @@unique([tier, pageKey])
}

// 個股每季 EPS 快照：證交所公開資料只提供「最新一季」，沒有歷史查詢功能，
// 所以查詢過的股票會逐季存進這張表，累積滿 4 筆(近4季)後才能算出 EPS(近4季)/ROE(近4季)。
model StockEpsSnapshot {
  id        String   @id @default(cuid())
  code      String
  year      Int
  season    Int
  eps       Float
  capturedAt DateTime @default(now())

  @@unique([code, year, season])
  @@index([code])
}

// 法人買賣超／融資融券逐日快照：證交所公開資料只有「單一日期、全部股票」的日報表，
// 沒有「單一股票、歷史區間」查詢功能，所以查詢過的股票會逐日存進這兩張表，隨使用時間累積歷史，
// 用來畫「近1個月/3個月/6個月/1年/3年」趨勢圖（見 flow-history API）。
model StockInstitutionalSnapshot {
  id             String   @id @default(cuid())
  code           String
  date           String
  foreignNetLots Int
  trustNetLots   Int
  dealerNetLots  Int
  totalNetLots   Int
  capturedAt     DateTime @default(now())

  @@unique([code, date])
  @@index([code])
}

model StockMarginSnapshot {
  id            String   @id @default(cuid())
  code          String
  date          String
  marginBalance Int
  marginChange  Int
  shortBalance  Int
  shortChange   Int
  capturedAt    DateTime @default(now())

  @@unique([code, date])
  @@index([code])
}

// 集保股權分散表沒有歷史查詢功能（每次都只回傳最新一週），只能每次查詢時逐週snapshot累積，
// 沒辦法像三大法人／融資融券那樣主動往回補歷史。
model StockRetailRatioSnapshot {
  id                  String   @id @default(cuid())
  code                String
  date                String
  totalShares         Float
  totalHolders        Int
  below20LotsShares   Float
  below20LotsHolders  Int
  below50LotsShares   Float
  below50LotsHolders  Int
  below100LotsShares  Float
  below100LotsHolders Int
  capturedAt          DateTime @default(now())

  @@unique([code, date])
  @@index([code])
}

// 全市場買超/賣超前15名（共30檔）逐日存檔：每次「即時成交量排行」頁面被查詢時，把當天上榜的
// 30檔（買超前15+賣超前15）連同收盤價一起存一筆，用公司代碼+日期當key，方便日後回顧某檔股票
// 哪些天上過榜、當天收盤價多少。只存有上榜的那30檔，沒上榜的股票不會有紀錄。
model MarketRankingSnapshot {
  id         String   @id @default(cuid())
  code       String
  name       String
  date       String
  closePrice Float?
  netLots    Int
  capturedAt DateTime @default(now())

  @@unique([code, date])
  @@index([date])
}

// 每次呼叫Gemini（目前只有智能助理）都記一筆token用量，供後台「TOKEN使用量」頁面依會員
// 彙總查詢，監控成本／抓濫用。feature欄位先留著，之後如果還有別的功能會呼叫AI才不用改表。
model TokenUsageLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature          String   @default("assistant")
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// 期交所三大法人期貨未平倉逐日存檔：每次台股頁被查詢時，把當天三大法人（自營商/投信/外資）
// 在各期貨契約（臺股期貨、電子期貨、金融期貨等）的多空未平倉都存一筆，用契約+身份別+日期當key。
model FuturesPositionSnapshot {
  id                 String   @id @default(cuid())
  date               String
  contractCode       String
  item               String // 自營商/投信/外資
  longOpenInterest   Int
  shortOpenInterest  Int
  netOpenInterest    Int
  capturedAt         DateTime @default(now())

  @@unique([date, contractCode, item])
  @@index([contractCode, item])
}
