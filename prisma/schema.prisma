generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  role         Role          @default(MEMBER)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions   Transaction[]
  categories     Category[]
  userBanks      UserBank[]
  userThirdParties UserThirdParty[]
  userBrokers    UserBroker[]
  userFunds      UserFund[]
  userExchanges  UserExchange[]
  userDebtCategories UserDebtCategory[]
  userExchangeRates UserExchangeRate[]
  investments    Investment[]
  debts          Debt[]
}

model UserBank {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model UserThirdParty {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model UserBroker {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model UserFund {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model UserExchange {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model UserDebtCategory {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model UserExchangeRate {
  id        String   @id @default(cuid())
  currency  String
  rate      Float
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, currency])
}

model Debt {
  id        String   @id @default(cuid())
  category  String
  amount    Float
  bankName  String?
  date      DateTime @default(now())
  note      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id           String          @id @default(cuid())
  name         String
  type         TransactionType
  icon         String?
  color        String?
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime        @default(now())
}

model Transaction {
  id         String          @id @default(cuid())
  title      String
  amount     Float
  type       TransactionType
  date       DateTime
  note       String?
  source     String          @default("CASH")
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category?       @relation(fields: [categoryId], references: [id])
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Investment {
  id            String         @id @default(cuid())
  type          InvestmentType
  name          String?
  code          String?
  amount        Float
  quantity      Float?
  price         Float?
  broker        String?
  bankName      String?
  currency      String?
  exchangeRate  Float?
  action        TradeAction    @default(BUY)
  date          DateTime       @default(now())
  discount      Float?
  fee           Float?
  tax           Float?
  note          String?
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum InvestmentType {
  STOCK
  FUND
  FOREX
  CRYPTO
  GOLD
  REALESTATE
  INSURANCE
}

enum TradeAction {
  BUY
  SELL
}

enum Role {
  MEMBER
  ADMIN
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model FeeSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  rate        Float    @default(0)
  fixedAmount Float    @default(0)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
